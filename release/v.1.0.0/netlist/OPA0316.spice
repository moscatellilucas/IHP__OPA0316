.SUBCKT sg13g2_DCNDiode anode cathode guard SUBX
*.PININFO anode:B cathode:B guard:B
DD1 SUBX cathode dantenna m=1 w=1.26u l=27.78u a=35.003p p=58.08u
DD0 SUBX cathode dantenna m=1 w=1.26u l=27.78u a=35.003p p=58.08u
RR0 anode SUBX ptap1 A=141.253p P=47.54u
.ENDS sg13g2_DCNDiode
.SUBCKT sg13g2_DCPDiode anode cathode guard SUBX
*.PININFO anode:B cathode:B guard:B
DD1 anode cathode dpantenna m=1 w=1.26u l=27.78u a=35.003p p=58.08u
DD0 anode cathode dpantenna m=1 w=1.26u l=27.78u a=35.003p p=58.08u
RR0 guard SUBX ptap1 A=33.524p P=23.16u
.ENDS sg13g2_DCPDiode
.SUBCKT sg13g2_IOPadIOVss vdd vss iovdd iovss SUBX
*.PININFO iovdd:B iovss:B vdd:B vss:B
XI3 iovss iovss iovdd / SUBX sg13g2_DCNDiode
XI2 iovss iovdd iovss / SUBX sg13g2_DCPDiode
RR1 vss SUBX ptap1 A=24.01p P=19.6u
RR0 iovss SUBX ptap1 A=5.487n P=296.3u
.ENDS sg13g2_IOPadIOVss
